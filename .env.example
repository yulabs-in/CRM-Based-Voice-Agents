# Public values (safe in the browser) — these live in .env
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_PROJECT_ID="<project-ref>"
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# Server secrets — put these in .env.local (git-ignored) or your host's secret settings. Never commit them.
# Supabase dashboard → Project Settings → API keys → secret / service_role key
SUPABASE_SERVICE_ROLE_KEY=""
# Sarvam Voice Agents workspace API key (indus.sarvam.ai → Samvaad → Settings → API key)
SARVAM_API_KEY=""
# Public https origin Sarvam can POST call results to (deployed URL, or a tunnel such as
# `cloudflared tunnel --url http://localhost:3000` while developing). Not localhost.
PUBLIC_APP_URL=""
# Optional: legacy generic webhook (/api/public/sarvam-webhook) shared secret
SARVAM_WEBHOOK_SECRET=""
